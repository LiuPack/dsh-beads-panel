{
  "name": "dsh-beads-panel",
  "version": "1.0.0",
  "description": "Beads issue-graph panel for the DeepSeek Harness left sidebar: browse ready/open beads, read issue detail, and create, claim, or close beads through the bd CLI.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "beads",
    "bd",
    "issues",
    "sidebar"
  ],
  "homepage": "https://github.com/LiuPack/dsh-beads-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuPack/dsh-beads-panel.git"
  },
  "bugs": {
    "url": "https://github.com/LiuPack/dsh-beads-panel/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
